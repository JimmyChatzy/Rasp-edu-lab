# Strapi address used by the Next.js server (server-to-server). Production: http://127.0.0.1:1337
STRAPI_URL=http://localhost:1337

# Public Strapi address used in the browser for images and files.
# Inlined into the JavaScript at `npm run build`: rebuild after changing it.
# Production: https://cms.example.gr
NEXT_PUBLIC_STRAPI_URL=http://localhost:1337

# documentId of the ScenarioDesign entry that holds the form schema and its tab layout
SCENARIO_SCHEMA_ID=gol1wvlw5o4paor1719wo41w
